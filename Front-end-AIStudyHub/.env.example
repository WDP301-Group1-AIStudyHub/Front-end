# Trailing slash is optional; the client normalises it.
VITE_API_BASE_URL=http://localhost:4000/

# Serves the BYOK credential and usage screens from an in-memory mock instead of
# the backend. Off by default — turn it on only to work on states that are
# awkward to reproduce for real, such as a rejected API key.
VITE_USE_MOCK_AI=false
